# Runtime
APP_ENV=development
FLASK_DEBUG=1
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
AUTO_CREATE_DB=1

# Security
SECRET_KEY=change-this-secret
SECRET_FERNET_KEY=change-with-32-byte-urlsafe-base64-key
SESSION_COOKIE_SECURE=0
SESSION_TTL_MINUTES=120
FORCE_HTTPS=0

# Database
DATABASE_URI=sqlite:///secure_career_system.db

# Email/OTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
SENDER_EMAIL=
ALLOW_LOCAL_OTP_FALLBACK=1

# AI Provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
